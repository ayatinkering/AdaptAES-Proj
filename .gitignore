__pycache__/
*.py[cod]

# Keep raw traffic captures local. PCAP files are large dataset artifacts.
data/raw/
*.pcap
*.pcapng

# Local environments and editor state.
.venv/
venv/
.env
.idea/
.vscode/

# Generated plaintext payload blobs can become large. Regenerate from CSVs.
results/payloads/*.bin

# Contains PCAP-derived addresses, timestamps, and ports. Keep local.
results/payloads/*_payload_manifest.csv
